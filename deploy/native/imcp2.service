[Unit]
Description=IMCP2 MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/imcp2
Environment=PORT=8000
Environment=PUBLIC_URL=__PUBLIC_URL__
Environment=RUST_LOG=info
# Also serve the beta II instance at /mcp-beta on STAGING only. deploy.sh
# substitutes __MCP_SERVE_BETA__ per environment: `1` on staging, empty on
# production. An empty value reads as off, so production serves /mcp (production
# II) alone; staging additionally exposes /mcp-beta (beta II).
Environment=MCP_SERVE_BETA=__MCP_SERVE_BETA__
# OpenAI Apps domain verification: the token the ChatGPT-directory submission
# portal reveals, served verbatim at /.well-known/openai-apps-challenge. Empty
# (the default) keeps that endpoint 404. Supplied via the
# OPENAI_APPS_CHALLENGE_TOKEN repository secret (world-readable at the
# endpoint by design; handled as a secret for consistency with the other
# deploy inputs).
Environment=OPENAI_APPS_CHALLENGE_TOKEN=__OPENAI_APPS_CHALLENGE_TOKEN__
# Dynamic client registrations persist here so OAuth clients that cached their
# client_id keep working across redeploys. StateDirectory (=/var/lib/imcp2) is
# created service-owned and survives restarts; /opt/imcp2 is replaced each deploy.
StateDirectory=imcp2
Environment=OAUTH_CLIENTS_FILE=%S/imcp2/oauth-clients.json
ExecStart=/opt/imcp2/imcp2
Restart=always
RestartSec=3
LimitNOFILE=65536
# Graceful stop: systemd sends SIGTERM (the app drains in-flight requests on it),
# then waits up to TimeoutStopSec before escalating to SIGKILL. Ample for our
# short request handlers; keeps a `restart` from cutting live requests.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
