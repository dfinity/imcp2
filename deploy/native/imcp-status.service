[Unit]
Description=imcp2 status dashboard (mcp-status)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/imcp2/monitoring/mcp-status
# Probe the public deployment end-to-end (through Caddy/TLS). Which Internet
# Identity instances to probe is read from this server's own /version, so no II
# origin is configured here. The allowlist is pinned to the deployment's own host
# (the dashboard always permits the built-in id.ai suffixes on top), so the probes
# can never be steered elsewhere -- including by the server's own /version.
# Binds to 127.0.0.1; Caddy publishes it under https://<domain>/status/.
Environment=MCP_STATUS_ALLOWED_HOSTS=__ALLOWED_HOSTS__
# Optional: mirror the verdict to an Atlassian Statuspage component (e.g. on
# status.internetcomputer.org). The file holds STATUSPAGE_PAGE_ID,
# STATUSPAGE_API_KEY and STATUSPAGE_COMPONENT_ID (see the mcp-status README).
# It is created by the operator (mode 600, owner root), never by deploy.sh, so
# the API key stays out of this repository and of the rendered unit file. The
# leading "-" makes it optional: without the file the pusher never starts.
EnvironmentFile=-/etc/imcp-status/statuspage.env
ExecStart=/usr/bin/node /opt/imcp2/monitoring/mcp-status/server.js --port 8137 --host 127.0.0.1 --mcp https://__DOMAIN__
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
