[Unit]
Description=imcp2 status dashboard (mcp-status)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated system user (created by deploy.sh), NOT the ec2-user the
# internet-facing imcp2.service runs as: this process can carry a Statuspage
# API key in its environment, and same-UID processes can read each other's
# /proc/<pid>/environ — a compromise of the main service must not be able to
# recover that secret. For the same reason the unit executes the ROOT-OWNED
# copy deploy.sh installs at /opt/imcp-status, not the ec2-user-writable
# staging tree under /opt/imcp2/monitoring: code writable by the main
# service's UID would hand the secret to whoever can modify it.
User=imcp-status
WorkingDirectory=/opt/imcp-status
# Probe every instance end-to-end (through its Caddy/TLS), one dashboard column
# each: deploy.sh renders the set (by default staging and production, so every
# host shows the same two columns). Which Internet Identity instances to probe
# is read from each server's own /version; a target whose /version cannot be
# read -- production's edge currently answers it with a redirect -- gets its II
# pinned via MCP_STATUS_TARGET_II. The allowlist is pinned to this host plus each
# target's host (the dashboard always permits the built-in id.ai suffixes on
# top), so the probes can never be steered elsewhere -- including by a server's
# own /version. Binds to 127.0.0.1; Caddy publishes it under
# https://<domain>/status/.
Environment="MCP_STATUS_TARGETS=__TARGETS__"
Environment="MCP_STATUS_TARGET_II=__TARGET_II__"
Environment=MCP_STATUS_ALLOWED_HOSTS=__ALLOWED_HOSTS__
# Optional: mirror the verdict to an Atlassian Statuspage component (e.g. on
# status.internetcomputer.org). The file holds STATUSPAGE_PAGE_ID,
# STATUSPAGE_API_KEY and STATUSPAGE_COMPONENT_ID (see the mcp-status README).
# It is created by the operator (mode 600, owner root), never by deploy.sh, so
# the API key stays out of this repository and of the rendered unit file. The
# leading "-" makes it optional: without the file the pusher never starts.
EnvironmentFile=-/etc/imcp-status/statuspage.env
ExecStart=/usr/bin/node /opt/imcp-status/server.js --port 8137 --host 127.0.0.1
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
