{
  email __ACME_EMAIL__
}
__DOMAIN__ {
  # Status dashboard (internal Node service on :8137), published under /status/.
  # handle_path strips the /status prefix, so the dashboard sees /, /api/status,
  # etc. as if mounted at the root; its assets are loaded path-relative.
  redir /status /status/ 308
  handle_path /status/* {
    reverse_proxy 127.0.0.1:8137
  }

  # Everything else is the MCP server.
  handle {
    # Retry the upstream for a few seconds if the dial fails, so the ~1-3s gap
    # while `mcp-poc` restarts on a redeploy is bridged (requests wait + retry)
    # instead of surfacing as 502s to clients. Pairs with the app's graceful
    # SIGTERM drain so in-flight requests finish and new ones hold briefly.
    reverse_proxy 127.0.0.1:8000 {
      lb_try_duration 5s
      lb_try_interval 250ms
    }
  }
}
