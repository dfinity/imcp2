{
  email __ACME_EMAIL__
}
__DOMAIN__ {
  # Status dashboard (internal Node service on :8137), published under /status/.
  # handle_path strips the /status prefix, so the dashboard sees /, /api/status,
  # etc. as if mounted at the root; its assets are loaded path-relative.
  redir /status /status/ 308
  handle_path /status/* {
    reverse_proxy 127.0.0.1:8137
  }

  # Prometheus exposition is not published on this origin. On this host the app
  # does serve /metrics (imcp2.service sets MCP_SERVE_METRICS=1), but on
  # 0.0.0.0:8000 — so a scraper reaches it directly on the host's private address
  # over the VPN, the same path the deploy already uses, and nothing needs to be
  # published here to make that work.
  #
  # This block is what makes that true, so it is load-bearing rather than
  # decorative: without it the catch-all below reverse-proxies /metrics to the app
  # like any other path, and the exposition is on the public internet. The app's
  # own gate is the other half — a deployment with no proxy in front (the bundled
  # Dockerfile on a PaaS) leaves MCP_SERVE_METRICS unset and serves no /metrics at
  # all, since there would be nothing here to hide it.
  #
  # Returning 404 rather than 403 so the endpoint is not advertised as existing.
  # Metrics are not secret, but they are a free operational read: request volumes
  # and error rates by route, live session counts, process memory. That is
  # reconnaissance for anyone probing the service, and a public scrape target is
  # also an amplification lever, since each request makes the process gather and
  # encode its whole registry.
  handle /metrics {
    respond 404
  }

  # Everything else is the MCP server.
  handle {
    # Retry the upstream for a few seconds if the dial fails, so the ~1-3s gap
    # while `imcp2` restarts on a redeploy is bridged (requests wait + retry)
    # instead of surfacing as 502s to clients. Pairs with the app's graceful
    # SIGTERM drain so in-flight requests finish and new ones hold briefly.
    reverse_proxy 127.0.0.1:8000 {
      lb_try_duration 5s
      lb_try_interval 250ms
    }
  }
}
