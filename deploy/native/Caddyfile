{
  email __ACME_EMAIL__
  # Slow-loris / slow-body containment on the public edge. Without these, a
  # client can hold a connection open by dribbling the request headers or body a
  # byte at a time and tie up server resources; HTTP/2 makes it cheaper still
  # (many concurrent streams per connection). Bound how long a request may take
  # to arrive: headers within 10s, the full body within 30s (MCP request bodies
  # are small JSON — this is generous for a legit slow link, tight for an
  # attacker), and idle keep-alive connections close after 120s.
  #
  # `write` is deliberately left at the default (unbounded): the MCP streamable
  # transport answers with long-lived Server-Sent-Events responses, and a write
  # timeout would cut those streams. `idle` governs the gap *between* requests on
  # a kept-alive connection, not an in-flight streaming response, so it is safe.
  servers {
    timeouts {
      read_header 10s
      read_body 30s
      idle 120s
    }
  }
}
__DOMAIN__ {
  # Status dashboard (internal Node service on :8137), published under /status/.
  # handle_path strips the /status prefix, so the dashboard sees /, /api/status,
  # etc. as if mounted at the root; its assets are loaded path-relative.
  redir /status /status/ 308
  handle_path /status/* {
    reverse_proxy 127.0.0.1:8137
  }

  # The app serves /metrics on its own port (imcp2.service sets
  # MCP_SERVE_METRICS=1); a scraper reaches it on the host's private address.
  # This block keeps it OFF the public origin — without it the catch-all below
  # proxies /metrics like any other path. 404 rather than 403 so the endpoint is
  # not advertised; deploy.sh asserts this exact response on every deploy.
  handle /metrics {
    respond 404
  }

  # Everything else is the MCP server.
  handle {
    # Retry the upstream for a few seconds if the dial fails, so the ~1-3s gap
    # while `imcp2` restarts on a redeploy is bridged (requests wait + retry)
    # instead of surfacing as 502s to clients. Pairs with the app's graceful
    # SIGTERM drain so in-flight requests finish and new ones hold briefly.
    reverse_proxy 127.0.0.1:8000 {
      lb_try_duration 5s
      lb_try_interval 250ms
    }
  }
}
