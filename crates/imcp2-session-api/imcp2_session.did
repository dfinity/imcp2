// The imcp2 session canister: the store imcp2 backends share their granted
// OAuth / Internet Identity sessions through.
//
// Times are Unix seconds of IC time unless the name ends in `_ns`.
// Every method takes one record and returns `variant { Ok : …; Err : … }`.
// Evolution rules (pinned by the API crate's wire tests):
//   * records only gain `opt` fields;
//   * error cases (`err_case`, inside an `opt`) may be added: an older reader
//     decodes one it does not know as null and still has `err_code`;
//   * every other returned variant never gains cases;
//   * methods are only ever added.

type Key = blob;        // 32 bytes: namespace(16) ‖ SHA-256("imcp2/rk/v1\00" ‖ namespace ‖ sid_uuid)[0..16]
type Namespace = blob;  // 16 bytes
type OpId = blob;       // 16 bytes
type Seconds = nat64;
type Seq = nat64;       // strictly increasing: max(head + 1, IC time in ns)

type Config = record {
  authorized : vec principal;            // at most 32, never anonymous; empty = nobody
  idle_timeout_secs : nat64;             // default 2_592_000 (30 d); 3_600 ..= 31_536_000
  max_sessions : nat64;                  // default 2_000_000 (memory tripwire)
  max_sessions_per_namespace : nat64;    // default 1_000_000; <= max_sessions
  purge_interval_secs : nat32;           // default 60; 10 ..= 3_600
  purge_batch : nat32;                   // default 2_000; 100 ..= 20_000
};
type ConfigPatch = record {
  authorized : opt vec principal;
  idle_timeout_secs : opt nat64;
  max_sessions : opt nat64;
  max_sessions_per_namespace : opt nat64;
  purge_interval_secs : opt nat32;
  purge_batch : opt nat32;
};
type InstallArg = variant { Init : ConfigPatch; Upgrade : opt ConfigPatch };

// Errors are records, so that their cases can grow (see the evolution rules).
// `err_code` is one space shared by every error type, never reused:
//   1 Unauthorized, 2 InvalidArgument, 10 AlreadyExists, 11 Deleted,
//   12 GrantExpired, 13 CapacityExceeded, 20 AlreadyConsumed, 21 BadProof,
//   22 NotFound, 23 CodeExpired, 30 PurgeInProgress.
type CommonErrorCase = variant { Unauthorized; InvalidArgument; PurgeInProgress };
type CommonError = record { err_code : nat64; err_case : opt CommonErrorCase; err_str : text };

// A granted session. `sealed` is the XChaCha20-Poly1305 envelope the backends
// seal under their shared keyring; the canister never sees inside it, except
// its key id (byte 2, after a format and a purpose byte).
type SessionRecord = record {
  key : Key;
  seq : Seq;                    // 0 until the authorization code is consumed
  op_id : OpId;
  created_at : Seconds;
  grant_expires_at : Seconds;
  last_active_at : Seconds;     // created_at, then consumed_at, then raised by touches
  consumed_at : opt Seconds;
  sealed : blob;                // 3 to 1024 bytes; byte 2 is the key id
};
type Tombstone = record {
  key : Key;
  seq : Seq;
  deleted_at : Seconds;
  grant_expires_at : Seconds;
  reason : text;                // "idle" | "evicted" | "admin_purge"
};
type Change = variant { Live : SessionRecord; Deleted : Tombstone };
type Lookup = variant { Live : SessionRecord; Deleted : Tombstone; Absent };

type PutSessionArg = record {
  key : Key;
  op_id : OpId;
  grant_expires_at : Seconds;
  sealed : blob;                // 3 to 1024 bytes; byte 2 is the key id
  code_lock : blob;             // 16 bytes: SHA-256(code_proof)[0..16]
};
type PutSessionErrorCase = variant {
  Unauthorized;
  InvalidArgument;
  AlreadyExists;                // the key is stored under a different op_id
  Deleted;                      // the key is tombstoned; keys are never reused
  GrantExpired;
  CapacityExceeded;             // at a cap, and nothing could safely be evicted
};
type PutSessionError = record { err_code : nat64; err_case : opt PutSessionErrorCase; err_str : text };
type PutSessionResult = variant { Ok : SessionRecord; Err : PutSessionError };

type ConsumeCodeArg = record { key : Key; exchange_id : OpId; code_proof : blob };
type ConsumeCodeErrorCase = variant {
  Unauthorized;
  InvalidArgument;
  AlreadyConsumed;              // exchanged under a different exchange_id
  BadProof;                     // the record stays unconsumed
  NotFound;
  Deleted;
  CodeExpired;                  // past the consume window
};
type ConsumeCodeError = record { err_code : nat64; err_case : opt ConsumeCodeErrorCase; err_str : text };
type ConsumeCodeResult = variant { Ok : SessionRecord; Err : ConsumeCodeError };

// An activity report: the session was in use at `last_active_at`.
type Touch = record { key : Key; last_active_at : Seconds };
type TouchSessionsArg = record { touches : vec Touch };        // at most 2000
type TouchResult = variant { Ok : record { updated : nat32; unknown : vec Key }; Err : CommonError };

type GetSessionsArg = record { keys : vec Key };               // at most 100
type GetSessionsResult = variant {
  Ok : record { items : vec Lookup; epoch : nat64; now_ns : nat64 };
  Err : CommonError;
};

// `limit`: 500 when null, clamped to 1 to 1000 (0 counts as 1).
type ListChangesArg = record { after : Seq; limit : opt nat32 };
type ChangesPage = record {
  changes : vec Change;         // seq > after, ascending
  complete : bool;              // nothing exists after next_after
  next_after : Seq;             // complete ? max(after, head) : seq of the last change
  head : Seq;                   // highest seq assigned; a snapshot load rewinds it
                                // (epoch moves once the load is noticed): compare
                                // positions only within one epoch
  epoch : nat64;                // bumped when the canister history shows a snapshot load,
                                // which restores the snapshot's state wholesale (sessions
                                // deleted after it are live again): operators replay
                                // revocations from their admin journal right after it
  now_ns : nat64;
  idle_timeout_secs : nat64;
  idle_floor_at : Seconds;
  key_checks_version : nat64;
};
type ListChangesResult = variant { Ok : ChangesPage; Err : CommonError };

type KeyCheck = record { kid : nat8; check : blob };   // 16 bytes = HKDF(K[kid], "imcp2/keycheck/v1")
type KeyChecks = record {
  version : nat64;
  checks : vec KeyCheck;
  retired : blob;               // retired kids, one byte each, ascending
  now_ns : nat64;
};
type KeyChecksResult = variant { Ok : KeyChecks; Err : CommonError };
type GetKeyChecksArg = record {};
// `replace`: whether an existing, different check for `kid` may be replaced
// (null = false).
type SetKeyCheckArg = record { kid : nat8; check : blob; replace : opt bool };
type RetireKidArg = record { kid : nat8 };

// A session is purged when it matches every condition; `Any` places none, so
// all `Any` purges everything. Every field is required, so a misspelled or
// missing one is refused instead of silently widening the purge (Candid drops
// fields a type does not declare).
type PurgeFilter = record {
  namespace : variant { Any; Is : Namespace };
  kid : variant { Any; Is : nat8 };             // byte 2 of the sealed envelope
  opened_by : variant { Any; Is : principal };
  created_from : variant { Any; Is : Seconds };  // created_at >= created_from
  created_to : variant { Any; Is : Seconds };    // created_at <= created_to
};
type PurgeJob = record {
  filter : PurgeFilter;
  started_at : Seconds;
  scanned : nat64;
  purged : nat64;
  done : bool;
};
type PurgeJobResult = variant { Ok : PurgeJob; Err : CommonError };

type NamespaceCount = record { namespace : Namespace; sessions : nat64; tombstones : nat64 };
type CallerStats = record {
  caller : principal;
  authorized : bool;
  opened : nat64;
  consumed : nat64;
  last_seen_at : Seconds;
};
type Counters = record {
  opened : nat64;
  consumed : nat64;
  abandoned : nat64;
  expired : nat64;
  idle_purged : nat64;
  evicted : nat64;
  admin_purged : nat64;
  tombstones_collected : nat64;
  restores_detected : nat64;
};
type Status = record {
  version : text;
  git_commit : text;
  config : Config;
  sessions : nat64;
  tombstones : nat64;
  per_namespace : vec NamespaceCount;
  head : Seq;
  epoch : nat64;
  idle_floor_at : Seconds;
  key_checks : KeyChecks;
  callers : vec CallerStats;
  purge_job : opt PurgeJob;
  counters : Counters;
  last_purge_at : Seconds;
  purge_backlog_secs : nat64;   // age of the oldest record overdue for removal
  cycle_balance : nat;
  stable_memory_bytes : nat64;
  now_ns : nat64;
};
type GetStatusArg = record {};
type StatusResult = variant { Ok : Status; Err : CommonError };
type ConfigResult = variant { Ok : Config; Err : CommonError };

service : (InstallArg) -> {
  // --- Authorized backends ---------------------------------------------------
  // At sign-in (`/oauth/connect/redeem`), before the authorization code is
  // issued: store the new session's sealed record, unconsumed and outside the
  // feed. Create-only, and idempotent per `op_id`: a retry from any backend gets
  // the stored record.
  put_session : (PutSessionArg) -> (PutSessionResult);
  // At the token exchange (`/oauth/token`): consume the authorization code,
  // once. Checks the code proof against the record's `code_lock` (so a code is
  // useless without the session key it was derived from), marks the record
  // consumed and gives it a feed position, so every backend then mirrors it.
  // Consensus makes a code single-use across backends; idempotent per
  // `exchange_id`, so a retried exchange from any backend gets the same record,
  // and so the same access token: a retry never mints a second credential.
  // `exchange_id` is derived from the code and its PKCE verifier, so only the
  // client that holds the verifier can retry, and only while backends still
  // accept the code; any other exchange of a consumed code is AlreadyConsumed.
  consume_code : (ConsumeCodeArg) -> (ConsumeCodeResult);
  // Activity reports (see `Touch`): raise each consumed record's
  // `last_active_at`, which the idle purge and eviction judge.
  touch_sessions : (TouchSessionsArg) -> (TouchResult);
  // Look sessions up by key, agreed by consensus: an answer a backend may act
  // on, including to drop a session.
  get_sessions : (GetSessionsArg) -> (GetSessionsResult);
  // The same answer from one replica, not agreed by consensus: a cheap hint a
  // backend may only use to add a record it can verify, never to drop one, and
  // never for a key whose deletion it has already read from an update. A stale
  // replica can delay a deletion until the next replicated read, never undo it.
  get_sessions_non_replicated : (GetSessionsArg) -> (GetSessionsResult) query;
  // A page of the change feed (consumed records and tombstones), agreed by
  // consensus.
  list_changes : (ListChangesArg) -> (ListChangesResult);
  // The same page from one replica: a hint, as for get_sessions_non_replicated.
  list_changes_non_replicated : (ListChangesArg) -> (ListChangesResult) query;
  // --- Authorized backends and controllers ------------------------------------
  // The published key checks and retired key ids.
  get_key_checks : (GetKeyChecksArg) -> (KeyChecksResult);
  // Configuration, counts, counters, callers and the purge job.
  get_status : (GetStatusArg) -> (StatusResult);
  // --- Controllers -------------------------------------------------------------
  // Change the configuration. Also re-arms the purge timer, even for an empty
  // patch, and schedules an immediate timer run, which checks the canister
  // history for a snapshot load.
  admin_update_config : (ConfigPatch) -> (ConfigResult);
  admin_set_key_check : (SetKeyCheckArg) -> (KeyChecksResult);
  admin_retire_kid : (RetireKidArg) -> (KeyChecksResult);
  // Start a resumable purge, which the timer works through.
  admin_purge_sessions : (PurgeFilter) -> (PurgeJobResult);
}
